{
  "name": "biaoxi-oss-trial",
  "version": "0.5.6-alpha.2",
  "description": "标析 — 本地招标文件分析助手",
  "private": true,
  "type": "module",
  "main": "src/desktop/main.cjs",
  "scripts": {
    "start": "node scripts/dev-isolated.mjs desktop",
    "dev": "node scripts/dev-isolated.mjs web",
    "test": "node scripts/run-tests.mjs",
    "build:mac": "node scripts/build-desktop.mjs darwin",
    "build:win": "node scripts/build-desktop.mjs win32 x64",
    "verify": "npm test",
    "verify:win-launcher": "node scripts/verify-windows-launcher.mjs",
    "start:safe": "node scripts/dev-isolated.mjs desktop",
    "dev:safe": "node scripts/dev-isolated.mjs web",
    "test:ocr": "node scripts/run-tests.mjs --ocr",
    "check:source": "node scripts/check-source.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.10",
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "cheerio": "1.2.0",
    "docx": "9.9.0",
    "express": "5.2.1",
    "mammoth": "1.13.0",
    "multer": "^2.4.0",
    "pdfjs-dist": "6.4.299",
    "pdfkit": "0.17.2",
    "sax": "1.6.1",
    "tesseract.js": "7.0.0",
    "word-extractor": "1.0.4",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "cn.biaoxi.oss.trial",
    "productName": "标析开源试用版",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "public/**/*",
      "assets/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "third_party/**/*",
      "vendor/README.md",
      "scripts/generate-icon.mjs"
    ],
    "extraResources": [
      {
        "from": "node_modules/electron/dist/LICENSE",
        "to": "runtime-notices/electron-44.7.0/LICENSE"
      },
      {
        "from": "node_modules/electron/dist/LICENSES.chromium.html",
        "to": "runtime-notices/electron-44.7.0/LICENSES.chromium.html"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "identity": "-",
      "target": [
        "dmg",
        "zip"
      ],
      "extraResources": [
        {
          "from": "node_modules/@napi-rs/canvas-darwin-${arch}",
          "to": "app/node_modules/@napi-rs/canvas-darwin-${arch}"
        }
      ],
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "artifactName": "biaoxi-oss-${version}-${arch}-mac.${ext}"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false,
      "extraResources": [
        {
          "from": "node_modules/@napi-rs/canvas-win32-x64-msvc",
          "to": "app/node_modules/@napi-rs/canvas-win32-x64-msvc"
        }
      ]
    },
    "asar": false,
    "npmRebuild": false,
    "icon": "assets/icon.png",
    "portable": {
      "unpackDirName": true,
      "artifactName": "biaoxi-oss-${version}-windows-${arch}-portable.${ext}"
    },
    "nsis": {
      "artifactName": "biaoxi-oss-${version}-windows-${arch}-setup.${ext}",
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "标析开源试用版",
      "uninstallDisplayName": "标析开源试用版",
      "unicode": true
    },
    "dmg": {
      "title": "标析开源试用版 ${version}"
    }
  },
  "optionalDependencies": {
    "@napi-rs/canvas-darwin-x64": "^1.0.10",
    "@napi-rs/canvas-win32-x64-msvc": "^1.0.10"
  },
  "overrides": {
    "mammoth": {
      "argparse": "2.0.1"
    },
    "@electron/get": {
      "global-agent": "4.1.3"
    }
  },
  "author": "标析",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0 <23",
    "npm": ">=10 <11"
  },
  "packageManager": "npm@10.9.8"
}
